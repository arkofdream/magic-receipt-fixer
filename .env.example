# Supabase Yapılandırması (Gereklidir)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key
SUPABASE_PROJECT_ID=your-project-id
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Vite / Client-Side Environment Variables (VITE_ ön ekiyle)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key
VITE_SUPABASE_PROJECT_ID=your-project-id

# e-Fatura Kimlik Bilgisi Şifreleme Anahtarı (AES-256)
# İsteğe bağlıdır; tanımlanmazsa SUPABASE_PROJECT_ID üzerinden güvenli anahtar türetilir.
EFATURA_CREDENTIALS_KEY=your_secure_random_32_byte_hex_or_string
